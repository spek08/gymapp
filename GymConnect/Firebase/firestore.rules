rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function getUserGym() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.primaryGymId;
    }
    
    function getOtherUserGym(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.primaryGymId;
    }
    
    function shareGym(userId) {
      return getUserGym() == getOtherUserGym(userId);
    }
    
    function isChatParticipant(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));
      return request.auth.uid in chat.data.participants;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can always read/write their own data
      allow read, write: if isAuthenticated() && isOwner(userId);
      
      // Others can read if same gym and profile is visible
      allow read: if isAuthenticated() 
        && shareGym(userId)
        && (resource.data.privacySettings.profileVisible == 'gym_only' 
            || resource.data.privacySettings.profileVisible == 'everyone');
      
      // Allow read if profile is public to everyone
      allow read: if isAuthenticated() 
        && resource.data.privacySettings.profileVisible == 'everyone';
    }
    
    // Gyms - public read for authenticated users
    match /gyms/{gymId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    // Checkins
    match /checkins/{checkinId} {
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid;
      
      allow read: if isAuthenticated() 
        && (resource.data.userId == request.auth.uid
            || (resource.data.isVisible 
                && shareGym(resource.data.userId)));
      
      allow update, delete: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
    }
    
    // Spotter requests
    match /spotterRequests/{requestId} {
      allow create: if isAuthenticated() 
        && request.resource.data.requesterId == request.auth.uid;
      
      allow read: if isAuthenticated() 
        && (resource.data.requesterId == request.auth.uid
            || resource.data.acceptedBy == request.auth.uid
            || (resource.data.isPublic 
                && shareGym(resource.data.requesterId)));
      
      allow update: if isAuthenticated() 
        && (resource.data.requesterId == request.auth.uid
            || resource.data.acceptedBy == request.auth.uid);
    }
    
    // Chats - participants only
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() 
        && request.auth.uid in resource.data.participants;
      
      allow create: if isAuthenticated() 
        && request.auth.uid in request.resource.data.participants;
    }
    
    // Messages - participants only
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if isAuthenticated() 
        && isChatParticipant(chatId);
    }
    
    // Reports - authenticated users can create
    match /reports/{reportId} {
      allow create: if isAuthenticated() 
        && request.resource.data.reporterId == request.auth.uid;
      
      allow read, update: if false;
    }
    
    // Blocks
    match /blocks/{blockId} {
      allow create: if isAuthenticated() 
        && request.resource.data.blockerId == request.auth.uid;
      
      allow read: if isAuthenticated() 
        && resource.data.blockerId == request.auth.uid;
      
      allow delete: if isAuthenticated() 
        && resource.data.blockerId == request.auth.uid;
    }
  }
}